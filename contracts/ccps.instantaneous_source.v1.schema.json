{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ccps.instantaneous-source.v1",
      "default": "ccps.instantaneous-source.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "operating_case_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operating Case Id",
      "type": "string"
    },
    "origin": {
      "enum": [
        "prism",
        "api581",
        "user_supplied"
      ],
      "title": "Origin",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Code Digest",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "release_kind": {
      "const": "instantaneous_pure_vapour",
      "title": "Release Kind",
      "type": "string"
    },
    "mass_kg": {
      "exclusiveMinimum": 0,
      "title": "Mass Kg",
      "type": "number"
    },
    "area_m2": {
      "exclusiveMinimum": 0,
      "title": "Area M2",
      "type": "number"
    },
    "temperature_k": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "qualification_basis": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Qualification Basis",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "scenario_id",
    "operating_case_id",
    "origin",
    "source_digest",
    "source_code_digest",
    "evidence_ids",
    "release_kind",
    "mass_kg",
    "area_m2",
    "temperature_k",
    "qualification_basis"
  ],
  "title": "DenseInventory",
  "type": "object"
}
