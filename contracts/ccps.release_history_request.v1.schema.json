{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DenseAtmosphere": {
      "additionalProperties": false,
      "properties": {
        "wind_speed_m_s": {
          "exclusiveMinimum": 0,
          "title": "Wind Speed M S",
          "type": "number"
        },
        "wind_reference_height_m": {
          "exclusiveMinimum": 0,
          "title": "Wind Reference Height M",
          "type": "number"
        },
        "temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "relative_humidity_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relative Humidity Fraction",
          "type": "number"
        },
        "roughness_length_m": {
          "exclusiveMinimum": 0,
          "title": "Roughness Length M",
          "type": "number"
        },
        "stability": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ],
          "title": "Stability",
          "type": "string"
        },
        "pressure_pa_abs": {
          "const": 101325.0,
          "default": 101325.0,
          "title": "Pressure Pa Abs",
          "type": "number"
        }
      },
      "required": [
        "wind_speed_m_s",
        "wind_reference_height_m",
        "temperature_k",
        "relative_humidity_fraction",
        "roughness_length_m",
        "stability"
      ],
      "title": "DenseAtmosphere",
      "type": "object"
    },
    "DenseReceptor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "downwind_distance_m": {
          "minimum": 0,
          "title": "Downwind Distance M",
          "type": "number"
        },
        "crosswind_distance_m": {
          "title": "Crosswind Distance M",
          "type": "number"
        },
        "height_m": {
          "minimum": 0,
          "title": "Height M",
          "type": "number"
        }
      },
      "required": [
        "id",
        "downwind_distance_m",
        "crosswind_distance_m",
        "height_m"
      ],
      "title": "DenseReceptor",
      "type": "object"
    },
    "DenseSubstance": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "molecular_weight_kg_mol": {
          "exclusiveMinimum": 0,
          "title": "Molecular Weight Kg Mol",
          "type": "number"
        },
        "vapor_heat_capacity_j_kg_k": {
          "exclusiveMinimum": 0,
          "title": "Vapor Heat Capacity J Kg K",
          "type": "number"
        },
        "liquid_heat_capacity_j_kg_k": {
          "exclusiveMinimum": 0,
          "title": "Liquid Heat Capacity J Kg K",
          "type": "number"
        },
        "latent_heat_j_kg": {
          "exclusiveMinimum": 0,
          "title": "Latent Heat J Kg",
          "type": "number"
        },
        "normal_boiling_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Normal Boiling Temperature K",
          "type": "number"
        },
        "liquid_density_kg_m3": {
          "exclusiveMinimum": 0,
          "title": "Liquid Density Kg M3",
          "type": "number"
        },
        "property_basis": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Property Basis",
          "type": "string"
        }
      },
      "required": [
        "name",
        "molecular_weight_kg_mol",
        "vapor_heat_capacity_j_kg_k",
        "liquid_heat_capacity_j_kg_k",
        "latent_heat_j_kg",
        "normal_boiling_temperature_k",
        "liquid_density_kg_m3",
        "property_basis"
      ],
      "title": "DenseSubstance",
      "type": "object"
    },
    "ReleaseHistory": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ccps.release-history.v1",
          "default": "ccps.release-history.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "operating_case_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Operating Case Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "prism",
            "user_supplied"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_code_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Code Digest",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "mode": {
          "enum": [
            "finite",
            "continuous_through_window"
          ],
          "title": "Mode",
          "type": "string"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/ReleaseInterval"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Intervals",
          "type": "array"
        },
        "declared_mass_within_history_kg": {
          "exclusiveMinimum": 0,
          "title": "Declared Mass Within History Kg",
          "type": "number"
        },
        "area_m2": {
          "exclusiveMinimum": 0,
          "title": "Area M2",
          "type": "number"
        },
        "temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "qualification_basis": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "boundary": {
          "const": "qualified_ground_level_thermalized_pure_vapour",
          "title": "Boundary",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "scenario_id",
        "operating_case_id",
        "origin",
        "source_digest",
        "source_code_digest",
        "evidence_ids",
        "mode",
        "intervals",
        "declared_mass_within_history_kg",
        "area_m2",
        "temperature_k",
        "qualification_basis",
        "boundary"
      ],
      "title": "ReleaseHistory",
      "type": "object"
    },
    "ReleaseInterval": {
      "additionalProperties": false,
      "properties": {
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "mass_rate_kg_s": {
          "minimum": 0,
          "title": "Mass Rate Kg S",
          "type": "number"
        }
      },
      "required": [
        "start_s",
        "end_s",
        "mass_rate_kg_s"
      ],
      "title": "ReleaseInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engine": {
      "const": "slabx",
      "default": "slabx",
      "title": "Engine",
      "type": "string"
    },
    "required_version": {
      "const": "1.0.8",
      "default": "1.0.8",
      "title": "Required Version",
      "type": "string"
    },
    "expected_engine_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Engine Code Digest",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ReleaseHistory"
    },
    "substance": {
      "$ref": "#/$defs/DenseSubstance"
    },
    "atmosphere": {
      "$ref": "#/$defs/DenseAtmosphere"
    },
    "receptors": {
      "items": {
        "$ref": "#/$defs/DenseReceptor"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Receptors",
      "type": "array"
    },
    "sample_times_s": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 2001,
      "minItems": 2,
      "title": "Sample Times S",
      "type": "array"
    },
    "simulation_end_s": {
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Simulation End S",
      "type": "number"
    },
    "native_puff_steps": {
      "default": 240,
      "maximum": 2000,
      "minimum": 80,
      "title": "Native Puff Steps",
      "type": "integer"
    },
    "timeout_s": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout S",
      "type": "number"
    },
    "tail_threshold_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Tail Threshold Kg M3",
      "type": "number"
    },
    "applicability": {
      "const": "left_held_ground_vapour_release_history",
      "title": "Applicability",
      "type": "string"
    },
    "plume_distance_limit_m": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Plume Distance Limit M",
      "type": "number"
    },
    "coupling": {
      "const": "independent_constant_segments_no_cloud_interaction",
      "title": "Coupling",
      "type": "string"
    },
    "pretransition_reconstruction": {
      "const": "mass_normalized_quasi_steady_growing_cloud",
      "title": "Pretransition Reconstruction",
      "type": "string"
    }
  },
  "required": [
    "expected_engine_code_digest",
    "source",
    "substance",
    "atmosphere",
    "receptors",
    "sample_times_s",
    "simulation_end_s",
    "tail_threshold_kg_m3",
    "applicability",
    "plume_distance_limit_m",
    "coupling",
    "pretransition_reconstruction"
  ],
  "title": "ReleaseHistoryInput",
  "type": "object"
}
