{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ccps.frequency.v1",
      "default": "ccps.frequency.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "operating_case_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operating Case Id",
      "type": "string"
    },
    "annual_frequency_per_year": {
      "minimum": 0,
      "title": "Annual Frequency Per Year",
      "type": "number"
    },
    "endpoint": {
      "const": "loss_of_containment",
      "default": "loss_of_containment",
      "title": "Endpoint",
      "type": "string"
    },
    "origin": {
      "enum": [
        "pha_core",
        "api581",
        "prism",
        "user_supplied"
      ],
      "title": "Origin",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Code Digest",
      "type": "string"
    },
    "included_factor_ids": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Included Factor Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "scenario_id",
    "operating_case_id",
    "annual_frequency_per_year",
    "origin",
    "source_digest",
    "source_code_digest",
    "evidence_ids"
  ],
  "title": "Frequency",
  "type": "object"
}
